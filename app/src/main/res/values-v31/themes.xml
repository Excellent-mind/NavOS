<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash is plain black with no icon, so the app's own
         animated logo starts from nothing instead of the icon vanishing and redrawing. -->
    <style name="Theme.NavOS" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
