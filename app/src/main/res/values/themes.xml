<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NavOS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/navos_navy</item>
        <item name="android:windowBackground">@color/navos_navy</item>

        <!-- App palette for every Material control and dialog (radio buttons,
             switches, checkboxes, dialog buttons), so they match the main UI
             instead of the stock purple / teal. -->
        <item name="colorPrimary">@color/navos_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/navos_navy</item>
        <item name="colorSecondary">@color/navos_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/navos_blue</item>
        <item name="android:colorAccent">@color/navos_blue</item>
        <item name="colorControlActivated">@color/navos_blue</item>
        <item name="colorSurface">@color/navos_surface</item>
        <item name="colorOnSurface">@color/navos_text</item>
        <!-- No grey "elevation overlay" lightening the dark surfaces. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NavOS.MaterialAlertDialog</item>
    </style>

    <!-- Rounded card dialog in the app's surface colour. -->
    <style name="ThemeOverlay.NavOS.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.NavOS</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.NavOS.Title.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NavOS.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NavOS.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.NavOS.DialogButton</item>
    </style>

    <style name="MaterialAlertDialog.NavOS" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.NavOS.Dialog</item>
    </style>

    <style name="ShapeAppearanceOverlay.NavOS.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="MaterialAlertDialog.NavOS.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/navos_text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.NavOS.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/navos_blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Launch splash: the NavOS logo on black. Switches to Theme.NavOS as soon
         as the first frame is ready. -->
    <style name="Theme.NavOS.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.NavOS</item>
    </style>

    <!-- Signal type scale: 46 sign distance, 38 ETA, 21 street, 17 body, 13 caption. -->
    <style name="TextAppearance.Signal" parent="">
        <item name="android:fontFamily">@font/signal_text</item>
        <item name="fontFamily">@font/signal_text</item>
        <item name="android:textColor">@color/sig_text</item>
    </style>
    <style name="TextAppearance.Signal.Body">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Signal.Input">
        <item name="android:textSize">19sp</item>
    </style>
    <style name="TextAppearance.Signal.Label">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Signal.Secondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/sig_text_quiet</item>
    </style>
    <style name="TextAppearance.Signal.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/sig_text_quiet</item>
    </style>
    <style name="TextAppearance.Signal.Overline">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/sig_text_quiet</item>
    </style>
    <style name="TextAppearance.Signal.Number" parent="">
        <item name="android:fontFamily">@font/signal_numbers</item>
        <item name="fontFamily">@font/signal_numbers</item>
        <item name="android:textColor">@color/sig_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.Signal.Number.Card">
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.Signal.Number.Row">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/sig_text_quiet</item>
    </style>

    <!-- Signal chip: 44dp pill, outline when off, ink when selected. -->
    <style name="Widget.Signal.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_sig_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Signal.Label</item>
        <item name="android:textColor">@color/sig_chip_text</item>
    </style>

    <!-- Smaller chip for the search filters (40dp, 14sp). -->
    <style name="Widget.Signal.Chip.Filter">
        <item name="android:layout_height">40dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
