<?xml version="1.0" encoding="utf-8"?>
<!-- One route card (Signal). Header: time in big numbers with the distance,
     the main road (or, for the other routes, how they differ) underneath;
     FASTEST tag and tolls / lights on the right. The selected card adds the
     trip block: a traffic line, the trip strip (whole trip on one line, from
     Now to Arrive), and count chips that light up one kind on the strip and
     list it. Other routes show a thin traffic strip instead.
     Outline and fill are set by RoutePreviewSheet (selected = ink outline). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="72dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/choiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Signal.Number"
                    android:textSize="28sp"
                    tools:text="24 min" />

                <TextView
                    android:id="@+id/choiceDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textAppearance="@style/TextAppearance.Signal.Number.Row"
                    android:textSize="18sp"
                    tools:text="12.4 km" />

            </LinearLayout>

            <TextView
                android:id="@+id/choiceVia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Signal.Secondary"
                android:textColor="@color/sig_text"
                tools:text="via E12 AKLEH" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/choiceFastest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_sig_tag"
                android:letterSpacing="0.04"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="@string/fastest"
                android:textAppearance="@style/TextAppearance.Signal.Label"
                android:textColor="@color/sig_on_ink"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/choiceTolls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:textAppearance="@style/TextAppearance.Signal.Caption"
                    android:visibility="gone"
                    tools:text="2 tolls" />

                <TextView
                    android:id="@+id/choiceLights"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Signal.Caption"
                    android:textColor="@color/sig_text_quiet"
                    android:visibility="gone"
                    tools:text="14 traffic lights" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Other routes: a thin strip with their traffic. -->
    <com.excellentmindblow.navos.TripStripView
        android:id="@+id/choiceMiniStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <!-- The selected route: the whole trip on one line. -->
    <LinearLayout
        android:id="@+id/choiceTrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/choiceTraffic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Signal.Body"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="Jam on Lebuhraya KL–Karak · +6 min" />

        <com.excellentmindblow.navos.TripStripView
            android:id="@+id/choiceStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/choiceNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Signal.Caption"
                tools:text="Now 5:22 PM" />

            <TextView
                android:id="@+id/choiceArrive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Signal.Caption"
                tools:text="Arrive 6:26 PM" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/choiceChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/choiceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
