<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.maplibre.android.maps.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Idle/free-roam top bar: search + settings. Hidden once a route
             is being previewed or driven, same as Waze/Google Maps hide
             their search bar during navigation - and, now there's a bottom
             tab bar, also hidden on the plain Map tab until Search is
             tapped. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Only shown when search was opened mid-drive (via the
                     drive bar's search icon) so there's a way back to the
                     nav view without having to pick a new destination. -->
                <ImageButton
                    android:id="@+id/searchBackButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/search_bar_bg"
                    android:backgroundTint="@color/navos_navy"
                    android:contentDescription="Back to navigation"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@drawable/search_bar_bg"
                    android:elevation="4dp"
                    android:hint="Search destination in Malaysia"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/navos_navy"
                    android:textColorHint="#80142A4B" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/search_bar_bg"
                    android:backgroundTint="@color/navos_navy"
                    android:contentDescription="Settings"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings" />

            </LinearLayout>

            <ListView
                android:id="@+id/searchResultsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/search_bar_bg"
                android:divider="#14142A4B"
                android:dividerHeight="1dp"
                android:elevation="4dp"
                android:maxHeight="320dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Active-nav turn instruction banner, pinned to the top like
             Waze/Google Maps' direction banner - stands in for topBar
             (hidden) while a route is being previewed or driven. One
             vertical card so the optional lane-guidance and "and then"
             rows grow the card instead of needing separate floating
             cards with fragile fixed offsets. -->
        <LinearLayout
            android:id="@+id/topNavBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/search_bar_bg"
            android:backgroundTint="@color/navos_navy"
            android:elevation="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/turnIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="Next turn"
                    android:src="@drawable/ic_nav_arrow" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/turnDistanceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="90 m" />

                    <TextView
                        android:id="@+id/turnStreetText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/navos_blue"
                        android:textSize="16sp"
                        tools:text="Lorong Sabudin" />

                </LinearLayout>

            </LinearLayout>

            <!-- Lane guidance for the upcoming turn - populated
                 programmatically (one icon per lane) since the lane count
                 varies per junction, and only shown when OSRM actually
                 returned lane-tagged data for this turn. -->
            <LinearLayout
                android:id="@+id/laneContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone" />

            <!-- "and then" secondary preview strip, once the step after
                 this one is known - same look-ahead Waze/Google Maps show
                 so the driver isn't surprised by a turn right after this
                 one. -->
            <LinearLayout
                android:id="@+id/nextTurnStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#2A3F63"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="and then"
                    android:textColor="#B8C4D9"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/nextTurnIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Then"
                    android:src="@drawable/ic_nav_arrow" />

            </LinearLayout>

        </LinearLayout>

        <!-- Live speed badge, shown only during active navigation - same
             bottom-left circular readout Waze shows. -->
        <TextView
            android:id="@+id/speedBadge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_circle_navy"
            android:elevation="4dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="0\nkm/h" />

        <!-- Re-centre, shown only once the driver pans the free-roam map
             away from their own position - tap to resume following. Kept
             on the right, clear of the bottom sheet/preview card, same as
             the equivalent control in Waze/Google Maps. -->
        <ImageButton
            android:id="@+id/recenterButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="120dp"
            android:background="@drawable/search_bar_bg"
            android:backgroundTint="@color/navos_navy"
            android:contentDescription="Re-centre on my location"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_recenter"
            android:visibility="gone" />

        <!-- "What do you see?" incident report button, shown only during
             active navigation - same spot the re-centre button uses in
             free-roam, since the two are never visible at once. -->
        <ImageButton
            android:id="@+id/reportButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="120dp"
            android:background="@drawable/search_bar_bg"
            android:backgroundTint="@color/navos_navy"
            android:contentDescription="Report what you see"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_report_button"
            android:visibility="gone" />

        <!-- Route preview: shown after a destination is picked, before the
             user commits to navigating. Lets them see distance/time (and
             switch between alternative routes drawn on the map) before
             tapping Start. -->
        <LinearLayout
            android:id="@+id/routePreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_sheet"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_drag_handle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/routePreviewSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/navos_navy"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="50 min • 49.9 km" />

                    <TextView
                        android:id="@+id/routePreviewHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#80142A4B"
                        android:textSize="13sp"
                        tools:text="2 routes found - tap a grey route to switch" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/cancelRouteButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_navy"
                    android:backgroundTint="#E3E7EC"
                    android:contentDescription="Cancel route preview"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/navos_navy" />

            </LinearLayout>

            <TextView
                android:id="@+id/startNavigationButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="GO"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Bottom ETA/stop bar, shown during active navigation - same
             bottom-sheet-style layout as Waze's "X · time · distance · ETA"
             bar, with the stop control on the left. -->
        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_sheet"
            android:backgroundTint="@color/navos_navy"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/stopNavigationButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Stop navigation"
                android:padding="8dp"
                android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/etaSummaryText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="50 min • 49.9 km • 12:10 am" />

            <!-- Search for a new destination without fully stopping the
                 current drive - opens the search bar, same spot Waze keeps
                 its magnifier icon in the drive bar. -->
            <ImageButton
                android:id="@+id/bottomSearchButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:contentDescription="Search for a new destination"
                android:padding="8dp"
                android:src="@drawable/ic_search" />

            <!-- Re-opens the route preview (with alternates redrawn) so the
                 driver can switch routes mid-drive, same spot Waze's fork
                 icon sits in the drive bar. -->
            <ImageButton
                android:id="@+id/bottomAltRouteButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:contentDescription="Switch route"
                android:padding="8dp"
                android:src="@drawable/ic_alt_route" />

        </LinearLayout>

        <!-- Saved places panel - Home/Work (and room to grow) as a proper
             list instead of small pills, reached via the bottom tab bar's
             Saved tab. Same bottom-sheet look as the route preview card. -->
        <LinearLayout
            android:id="@+id/savedPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="76dp"
            android:background="@drawable/bg_bottom_sheet"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Saved places"
                android:textColor="@color/navos_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/homeButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/search_bar_bg"
                android:backgroundTint="@color/navos_navy"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_home" />

                <TextView
                    android:id="@+id/homeButtonLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    tools:text="Home" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/workButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/search_bar_bg"
                android:backgroundTint="@color/navos_navy"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Work"
                    android:src="@drawable/ic_work" />

                <TextView
                    android:id="@+id/workButtonLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    tools:text="Work" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom tab bar - Map/Search/Saved/Settings, replacing the old
             always-open search bar as the free-roam home screen's entry
             point. Hidden during route preview/active navigation, which
             have their own bottom sheets. -->

        <!-- Required OpenStreetMap/OpenFreeMap attribution - was missing
             entirely before, which is a real ToS compliance gap, not just
             a nice-to-have. Sits just above the tab bar on the clean map;
             the full data-source note also lives in Settings. -->
        <TextView
            android:id="@+id/mapAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="80dp"
            android:background="#99FFFFFF"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="© OpenStreetMap contributors"
            android:textColor="@color/navos_navy"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/bottomTabBar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:background="@color/white"
            android:elevation="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabMapButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Map"
                    android:src="@drawable/ic_tab_map"
                    android:tint="@color/navos_navy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Map"
                    android:textColor="@color/navos_navy"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSearchButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Search"
                    android:src="@drawable/ic_tab_search"
                    android:tint="#80142A4B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Search"
                    android:textColor="#80142A4B"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSavedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Saved"
                    android:src="@drawable/ic_tab_saved"
                    android:tint="#80142A4B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Saved"
                    android:textColor="#80142A4B"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSettingsButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_tab_settings"
                    android:tint="#80142A4B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Settings"
                    android:textColor="#80142A4B"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Full-screen state: location permission was denied. Added
             because the app previously just showed a blank, unexplained
             map with no way forward - a real dead end, not a cosmetic
             gap. -->
        <LinearLayout
            android:id="@+id/permissionDeniedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D90E1B33"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Location permission needed"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="NavOS can't show your position or navigate without it."
                android:textColor="#B8C4D9"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/permissionRetryButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_pill_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Try again"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissionSettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Open app settings"
                android:textColor="@color/navos_blue"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Full-screen state: permission is granted but the phone's GPS
             toggle is off - previously also a silent dead end (location
             never arrives, nothing tells you why). -->
        <LinearLayout
            android:id="@+id/gpsDisabledOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D90E1B33"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Location services are off"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Turn on GPS in your phone's settings to see your position and navigate."
                android:textColor="#B8C4D9"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/gpsSettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_pill_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Open location settings"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <!-- Settings drawer, opened from the gear button next to search.
         Scrollable now that the profile header + help/about rows make it
         taller than a short screen may show at once. -->
    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:elevation="8dp"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Lightweight profile header - there's no account system yet, so
             this is a placeholder greeting rather than a real signed-in
             identity, same spirit as Waze's drawer header. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_navy"
                android:gravity="center"
                android:text="N"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hey, driver!"
                    android:textColor="@color/navos_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NavOS"
                    android:textColor="#80142A4B"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Settings"
            android:textColor="@color/navos_navy"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Voice guidance"
                android:textColor="@color/navos_navy"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/voiceGuidanceSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Map style"
            android:textColor="@color/navos_navy"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/mapStyleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/mapStyleLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Light"
                android:textColor="@color/navos_navy" />

            <RadioButton
                android:id="@+id/mapStyleDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Dark (coming soon)"
                android:textColor="#80142A4B" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <TextView
            android:id="@+id/helpFeedbackRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Help &amp; feedback"
            android:textColor="@color/navos_navy"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/aboutRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="About"
            android:textColor="@color/navos_navy"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NavOS"
            android:textColor="@color/navos_navy"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Powered by Excellent Mindblow"
            android:textColor="#80142A4B"
            android:textSize="12sp" />

    </LinearLayout>

    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
