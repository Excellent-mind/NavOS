<?xml version="1.0" encoding="utf-8"?>
<!-- One route in the Waze-style route list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:elevation="3dp"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/routeItemDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/navos_text"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="38 min" />

        <TextView
            android:id="@+id/routeItemMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/navos_text"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="9:55 AM  •  39 km" />

        <TextView
            android:id="@+id/routeItemVia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/navos_text"
            android:textSize="18sp"
            tools:text="Via E11 LDP Puchong" />

        <TextView
            android:id="@+id/routeItemToll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_toll_chip"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Toll ~RM4.20" />

    </LinearLayout>

    <TextView
        android:id="@+id/routeItemGo"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:background="@drawable/bg_pill_blue"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="96dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="Go"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>
