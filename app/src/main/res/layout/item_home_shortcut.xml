<?xml version="1.0" encoding="utf-8"?>
<!-- Home / Work shortcut card: label with icon, drive time in big numbers,
     and the saved place underneath. Filled and coloured from HomeScreen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sig_card"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="104dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/shortcutLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Signal.Label"
        tools:drawableStart="@drawable/ic_home"
        tools:text="Home" />

    <TextView
        android:id="@+id/shortcutValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Signal.Number.Card"
        tools:text="12 min" />

    <TextView
        android:id="@+id/shortcutDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Signal.Caption"
        tools:text="Taman Connaught, Cheras" />

</LinearLayout>
