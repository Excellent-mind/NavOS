<?xml version="1.0" encoding="utf-8"?>
<!-- Federal and town roads: the same sign panel in JKR blue.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/jkr_blue" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
