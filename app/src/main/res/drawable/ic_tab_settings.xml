<?xml version="1.0" encoding="utf-8"?>
<!-- Bold "settings" glyph purpose-built for the bottom tab bar. The
     drawer's gear button (ic_settings.xml) has 8 thin, intricate teeth -
     reads fine as a standalone toolbar icon, but shrunk into a 24dp tab
     next to the solid ic_tab_map/ic_tab_saved glyphs it looks busy and
     comparatively thin. This is a simplified 8-tooth gear with a thick
     hub ring and broad rectangular teeth, matching the same solid, chunky
     weight as the other three tab icons rather than the drawer gear's
     fine detail. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="M12,12m-6,0a6,6 0 1,1 12,0a6,6 0 1,1 -12,0M12,12m-3.4,0a3.4,3.4 0 1,1 6.8,0a3.4,3.4 0 1,1 -6.8,0" />
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="0">
        <path android:fillColor="#FF000000" android:pathData="M10.5,2.6h3v3.4h-3z" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="45">
        <path android:fillColor="#FF000000" android:pathData="M10.5,2.6h3v3.4h-3z" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="90">
        <path android:fillColor="#FF000000" android:pathData="M10.5,2.6h3v3.4h-3z" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="135">
        <path android:fillColor="#FF000000" android:pathData="M10.5,2.6h3v3.4h-3z" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="180">
        <path android:fillColor="#FF000000" android:pathData="M10.5,2.6h3v3.4h-3z" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="225">
        <path android:fillColor="#FF000000" android:pathData="M10.5,2.6h3v3.4h-3z" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="270">
        <path android:fillColor="#FF000000" android:pathData="M10.5,2.6h3v3.4h-3z" />
    </group>
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="315">
        <path android:fillColor="#FF000000" android:pathData="M10.5,2.6h3v3.4h-3z" />
    </group>
</vector>
