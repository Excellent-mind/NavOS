<?xml version="1.0" encoding="utf-8"?>
<!-- The driver's own position/heading marker ("my arrow") - redesigned
     bigger and as a bold flat chevron (cyan fill + white outline),
     matching Waze's arrow puck instead of the smaller circle-based one
     from the previous build. Rotated live by RenderMode.GPS using the
     device's GPS bearing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="60dp"
    android:height="60dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Soft translucent halo so it still reads clearly over a busy map. -->
    <path
        android:fillColor="#331CB0F6"
        android:pathData="M12,12m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0" />

    <!-- Bold chevron, pointing up (north/forward), cyan with a white
         outline - the same silhouette Waze uses for its driving arrow. -->
    <path
        android:fillColor="#1CB0F6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:strokeLineJoin="round"
        android:pathData="M12,3.3L19.2,19.6L12,15.6L4.8,19.6Z" />

</vector>
