<?xml version="1.0" encoding="utf-8"?>
<!-- Bold "search" glyph purpose-built for the bottom tab bar. The toolbar
     search icon (ic_search.xml) is a thin Material ring-and-handle glyph -
     fine on its own, but sitting next to the solid, chunky ic_tab_map and
     ic_tab_saved glyphs in the same row it reads noticeably lighter in
     visual weight, which is exactly the kind of mismatched-family defect a
     tab bar can't afford at a glance. This one uses the same thick-ring
     construction technique as the solid tab icons (even-odd circle pair,
     no hairline strokes) so all four tab icons carry matching ink weight. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="9.5"
        android:pivotY="9.5"
        android:rotation="45">
        <path
            android:fillColor="#FF000000"
            android:fillType="evenOdd"
            android:pathData="M9.5,9.5m-6.8,0a6.8,6.8 0 1,1 13.6,0a6.8,6.8 0 1,1 -13.6,0M9.5,9.5m-4.3,0a4.3,4.3 0 1,1 8.6,0a4.3,4.3 0 1,1 -8.6,0" />
        <path
            android:fillColor="#FF000000"
            android:pathData="M16.3,8.2h6v2.6h-6z" />
    </group>
</vector>
