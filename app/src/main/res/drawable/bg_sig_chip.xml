<?xml version="1.0" encoding="utf-8"?>
<!-- Signal chip: outline when off, ink fill when on (android:state_selected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sig_ink" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sig_sheet" />
            <stroke android:width="1.5dp" android:color="@color/sig_outline" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
