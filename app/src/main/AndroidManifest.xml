<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required to run NavigationService as a foreground service so an
         active drive keeps tracking/announcing turns when the screen locks
         or the driver switches apps - without this, Android would stop
         delivering location callbacks to a plain background component. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) requires every foreground-service type to be
         backed by its own permission; this is the one for "location". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Lets the ongoing-navigation notification actually show on API 33+
         (Android 13 made all notifications, including a foreground
         service's, opt-in). Requested at runtime before starting a drive;
         if denied, navigation still runs, the driver just won't see the
         persistent notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.NavOS"
        android:usesCleartextTraffic="false">


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NavOS"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets NavOS appear in "Open with" when another app opens a map
                 location (WhatsApp / Telegram shared location, map links).
                 App-style links first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
                <data android:scheme="google.navigation" />
                <data android:scheme="waze" />
            </intent-filter>

            <!-- Google Maps: long and short links (maps.app.goo.gl, goo.gl/maps,
                 g.co/kgs) on the main domain and common country domains. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="maps.google.com" />
                <data android:host="maps.google.com.my" />
                <data android:host="maps.google.com.sg" />
                <data android:host="maps.google.co.id" />
                <data android:host="maps.google.co.uk" />
                <data android:host="maps.google.com.au" />
                <data android:host="maps.google.co.in" />
                <data android:host="maps.app.goo.gl" />
                <data android:host="share.google" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="www.google.com" />
                <data android:host="google.com" />
                <data android:host="www.google.com.my" />
                <data android:host="google.com.my" />
                <data android:host="google.com.sg" />
                <data android:host="google.co.id" />
                <data android:host="google.co.uk" />
                <data android:host="google.com.au" />
                <data android:host="google.co.in" />
                <data android:host="www.google.com.sg" />
                <data android:host="www.google.co.id" />
                <data android:host="www.google.co.uk" />
                <data android:host="www.google.com.au" />
                <data android:host="www.google.co.in" />
                <data android:host="goo.gl" />
                <data android:host="g.co" />
                <data android:pathPrefix="/maps" />
                <data android:pathPrefix="/kgs" />
            </intent-filter>

            <!-- Waze (waze.com/ul?..., waze.com/ul/h<short code>, live-map). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="waze.com" />
                <data android:host="www.waze.com" />
                <data android:host="ul.waze.com" />
                <data android:pathPrefix="/ul" />
                <data android:pathPrefix="/live-map" />
            </intent-filter>

            <!-- Apple Maps, OpenStreetMap, Bing Maps, HERE. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="maps.apple.com" />
                <data android:host="www.openstreetmap.org" />
                <data android:host="osm.org" />
                <data android:host="openstreetmap.org" />
                <data android:host="share.here.com" />
                <data android:host="wego.here.com" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="www.bing.com" />
                <data android:host="bing.com" />
                <data android:pathPrefix="/maps" />
            </intent-filter>
            <!-- Select an address in any app -> "NavOS" in the text-selection menu. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- "Share" a place or address to NavOS. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Not exported - only this app ever starts/binds it (from
             MainActivity) or targets its "end navigation" action (from the
             notification action's own PendingIntent, which doesn't need
             exported="true" to work). -->

        <service
            android:name=".navigation.NavigationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
